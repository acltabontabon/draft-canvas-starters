    },
    {
      "id": "n.route",
      "kind": "code",
      "about": "gateway",
      "language": "yaml",
      "code": "routes:\n  - match: { prefix: /play }\n    route:\n      cluster: playback\n      timeout: 0.5s\n      retry_policy:\n        retry_on: 5xx,reset\n        num_retries: 2"
    },
