      }
    },
    {
      "id": "n.edge",
      "kind": "decision",
      "about": "edge",
      "text": "Video is served from appliances inside ISPs. The cloud only decides which appliance; it never streams a byte."
    },
    {
      "id": "n.graph",
      "kind": "decision",
      "about": "graph",
      "text": "One GraphQL query per screen: devices ship slowly, so the shape of a screen changes on the server."
    },
    {
      "id": "n.drm",
      "kind": "warning",
      "about": "licence",
      "text": "No licence, no playback. Licences are cached for a session and for downloads, so a DRM outage stops new plays only."
    },
