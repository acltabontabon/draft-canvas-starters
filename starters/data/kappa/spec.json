    ],
    "live": [
      860,
      300
    ],
    "view7": [
      1220,
      300
    ],
    "replay": [
      860,
      590
    ],
    "view8": [
      1220,
      590
    ],
    "dlq": [
      860,
      90
    ],
    "api": [
      1600,
      445
    ]
  },
  "_clearRoutes": true,
  "_fitGroups": {},
  "_alignCols": [
    [
      "lane-live",
      "lane-replay"
    ]
  ],
  "_place": [
    {
      "id": "title",
      "of": "@all",
      "side": "above",
      "gap": 56,
      "width": 1200,
      "height": 110
    }
  ]
}
