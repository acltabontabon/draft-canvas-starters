      "id": "search",
      "type": "database",
      "x": 2053,
      "y": 148.25,
      "width": 220,
      "height": 143,
      "z": 0,
      "text": "Listings Index",
      "description": "Answers buyers' searches and filters.",
      "technology": "Elasticsearch",
      "textOrigin": "explicit",
      "databaseKind": "search-index"
    },
