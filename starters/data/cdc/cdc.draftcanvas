      "width": 176,
      "height": 109,
      "z": 0,
      "text": "Cache Invalidator",
      "description": "Evicts listings whose row changed.",
      "technology": "Go",
      "textOrigin": "explicit",
      "serviceKind": "worker"
    },
    {
      "id": "cache",
      "type": "database",
      "x": 2033,
      "y": 408.25,
      "width": 260,
      "height": 143,
      "z": 0,
      "text": "Listing Cache",
      "description": "Serves listing pages without the database.",
      "technology": "Redis 7",
      "textOrigin": "explicit",
      "databaseKind": "cache"
    },
    {
      "id": "sink",
      "type": "service",
      "x": 1731,
      "y": 662.5,
      "width": 176,
      "height": 109,
      "z": 0,
      "text": "Warehouse Sink",
      "description": "Loads changes in micro-batches (Kafka Connect).",
      "technology": "Kafka",
      "textOrigin": "explicit",
      "serviceKind": "worker"
    },
    {
      "id": "warehouse",
      "type": "database",
      "x": 2043,
      "y": 678.1,
      "width": 240,
      "height": 114,
      "z": 0,
      "text": "Analytics",
      "description": "Keeps the full history for pricing analysts.",
      "technology": "Snowflake",
      "textOrigin": "explicit",
      "databaseKind": "generic",
      "attachments": [
        {
          "id": "n.deletes",
          "type": "note",
          "text": "Do analysts need deleted listings (tombstones) in Snowflake, or only the latest row?",
          "noteKind": "question",
          "width": 200,
          "height": 56
        }
      ]
    }
  ],
  "edges": [
    {
      "id": "edit",
      "source": "seller",
      "target": "api",
      "label": "Changes a price",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "calls",
      "semanticsOrigin": "inferred"
    },
    {
      "id": "write",
      "source": "api",
      "target": "db",
      "label": "UPDATE listings",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "readsWrites",
      "sourceAnchor": {
        "side": "right",
        "offset": 0.5
      },
      "targetAnchor": {
        "side": "left",
        "offset": 0.5
      },
      "semanticsOrigin": "explicit",
      "attachments": [
        {
          "id": "n.nodual",
          "type": "note",
          "text": "No dual writes: the API writes only its own database. Search, cache and warehouse learn from the log, after commit.",
          "noteKind": "decision",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "capture",
      "source": "db",
      "target": "connector",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "cdc",
      "cadence": "Streaming",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "publish",
      "source": "connector",
      "target": "changes",
      "label": "Row changes",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "publishes",
      "kind": "event",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "feed-search",
      "source": "changes",
      "target": "indexer",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "consumes",
      "kind": "event",
      "sourceAnchor": {
        "side": "right",
        "offset": 0.5
      },
      "targetAnchor": {
        "side": "left",
        "offset": 0.5
      },
      "semanticsOrigin": "explicit"
    },
    {
      "id": "index",
      "source": "indexer",
      "target": "search",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "indexes",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "park",
      "source": "indexer",
      "target": "dlq",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "deadLetters",
      "kind": "failure",
      "async": true,
      "sourceAnchor": {
        "side": "top",
        "offset": 0.5
      },
      "targetAnchor": {
        "side": "left",
        "offset": 0.5
      },
      "semanticsOrigin": "explicit",
      "deliveryAttempts": 3
    },
    {
      "id": "feed-cache",
      "source": "changes",
      "target": "invalidator",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "consumes",
      "kind": "event",
      "semanticsOrigin": "explicit"
    },
    {
      "id": "evict",
      "source": "invalidator",
      "target": "cache",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "invalidates",
      "semanticsOrigin": "explicit",
      "attachments": [
        {
          "id": "n.lag",
          "type": "note",
          "text": "Eventually consistent: for a moment the cache and the index can still show the old price.",
          "noteKind": "warning",
          "width": 200,
          "height": 56
        }
      ]
    },
    {
      "id": "feed-warehouse",
      "source": "changes",
      "target": "sink",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "consumes",
      "kind": "event",
      "sourceAnchor": {
        "side": "right",
        "offset": 0.5
      },
      "targetAnchor": {
        "side": "left",
        "offset": 0.5
      },
      "semanticsOrigin": "explicit"
    },
    {
      "id": "load",
      "source": "sink",
      "target": "warehouse",
      "label": "MERGE batches",
      "directed": true,
      "routing": "smoothstep",
      "semantic": "writes",
      "cadence": "Every 5 min",
      "semanticsOrigin": "explicit"
    }
  ],
  "viewport": {
    "x": 0,
    "y": 0,
    "zoom": 1
  },
  "settings": {
    "showSequence": true,
    "grid": "dots",
    "background": {
      "enabled": false,
      "fit": "cover",
      "dim": 0.55,
      "blur": 0
    }
  },
  "flows": [
    {
      "id": "price-change",
      "title": "A price change reaches every view",
      "steps": [
        {
          "id": "price-change.s1",
          "edgeId": "edit",
          "caption": "A seller drops the price of a listing."
        },
        {
          "id": "price-change.s2",
          "edgeId": "write",
          "caption": "The API writes one row, to its own database only, and answers."
        },
        {
          "id": "price-change.s3",
          "edgeId": "capture",
          "caption": "Once committed, the change is read from the write-ahead log."
        },
        {
          "id": "price-change.s4",
          "edgeId": "publish",
          "caption": "It is published once, keyed by listing id, with before and after."
        },
        {
          "id": "price-change.s5",
          "edgeId": "feed-search",
          "caption": "The search indexer reads it at its own pace."
        },
        {
          "id": "price-change.s6",
          "edgeId": "index",
          "caption": "Buyers now find the listing at the new price."
        },
        {
          "id": "price-change.s7",
          "edgeId": "feed-cache",
          "caption": "The same change, read independently by the cache invalidator."
        },
        {
          "id": "price-change.s8",
          "edgeId": "evict",
          "caption": "The cached listing page is evicted; the next view reloads it."
        },
        {
          "id": "price-change.s9",
          "edgeId": "feed-warehouse",
          "caption": "And once more by the warehouse sink."
        },
        {
          "id": "price-change.s10",
          "edgeId": "load",
          "caption": "Every five minutes, the batch is merged into Snowflake."
        }
      ],
      "accent": "teal"
    },
    {
      "id": "backfill",
      "title": "Backfill a new view",
      "steps": [
        {
          "id": "backfill.s1",
          "edgeId": "capture",
          "caption": "A new consumer needs every listing, not just new changes: Debezium snapshots."
        },
        {
          "id": "backfill.s2",
          "edgeId": "publish",
          "caption": "Existing rows are published as read events, then live changes follow."
        },
        {
          "id": "backfill.s3",
          "edgeId": "feed-warehouse",
          "caption": "The sink reads from the earliest offset and loads it all."
        },
        {
          "id": "backfill.s4",
          "edgeId": "load",
          "caption": "Snowflake catches up without a query against production."
        }
      ],
      "accent": "amber",
      "variantOf": "price-change"
    },
    {
      "id": "unmappable",
      "title": "A change cannot be indexed",
      "steps": [
        {
          "id": "unmappable.s1",
          "edgeId": "feed-search",
          "caption": "A new column arrives that the indexer cannot map."
        },
        {
          "id": "unmappable.s2",
          "edgeId": "park",
          "extraNodeIds": [
            "search"
          ],
          "caption": "After three tries it parks the change and keeps going."
        }
      ],
      "accent": "rose",
      "variantOf": "price-change"
    }
  ],
  "openPoints": [
    {
      "id": "op.wal",
      "kind": "tentative",
      "context": "Assumed: 24 h of WAL retention covers Debezium being down over a weekend. Confirm with the DBAs.",
      "targets": [
        {
          "kind": "edge",
          "id": "capture"
        }
      ]
    }
  ]
}
