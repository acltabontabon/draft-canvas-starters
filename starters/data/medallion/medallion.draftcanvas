        {
          "id": "n.expect",
          "type": "code",
          "language": "sql",
          "code": "CREATE OR REFRESH STREAMING TABLE silver.trips (\n  CONSTRAINT valid_fare EXPECT (fare_cents >= 0) ON VIOLATION DROP ROW,\n  CONSTRAINT known_city EXPECT (city_id IS NOT NULL) ON VIOLATION DROP ROW\n)\nAS SELECT DISTINCT trip_id, city_id, driver_id,\n       CAST(fare * 100 AS INT) AS fare_cents, ended_at\nFROM STREAM(bronze.trips_raw);",
          "width": 587,
          "height": 177.625
        }
      ]
    },
